{
  "manifest_version": 3,
  "name": "FullShot",
  "version": "1.0.0",
  "description": "Captura de pantalla completa rápida, sencilla y confiable.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": ["editor.html", "editor.js", "editor.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "capture-fullpage": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "MacCtrl+Shift+F"
      },
      "description": "Capturar página completa"
    }
  }
}
